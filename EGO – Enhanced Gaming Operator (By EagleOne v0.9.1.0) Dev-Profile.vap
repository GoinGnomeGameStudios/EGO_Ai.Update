          <KeyCodes />
          <Context>public class VAInline
{
    public void main()
    {
        try
        {
            string utterance = VA.GetText("EGO_VoiceInput") ?? "";
            string mode      = VA.GetText("EGO_ShipMode")   ?? "normal";
            string safety    = VA.GetText("EGO_Safety")     ?? "safe";
            string shipId    = VA.GetText("EGO_ShipId")     ?? "";

            if (utterance.Trim().Length == 0)
            {
                VA.WriteToLog("[EGO] EGO_VoiceInput is empty.", "red");
                return;
            }

            string su = utterance.Replace("\\", "\\\\").Replace("\"", "\\\"");
            string sm = mode.Replace("\\", "\\\\").Replace("\"", "\\\"");
            string ss = safety.Replace("\\", "\\\\").Replace("\"", "\\\"");
            string shipField = (shipId.Trim().Length == 0)
                ? "\"shipId\":null"
                : "\"shipId\":\"" + shipId.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";

            string json =
                "{\"utterance\":\"" + su + "\"," +
                "\"mode\":\""       + sm + "\"," +
                "\"safety\":\""     + ss + "\"," +
                shipField + "}";

            string path = System.IO.Path.Combine(
                System.IO.Path.GetTempPath(), "ego_interpret_request.json");

            System.IO.File.WriteAllText(path, json, System.Text.Encoding.UTF8);

            VA.WriteToLog("[EGO] Interpret request written — awaiting plugin.", "blue");
        }
        catch (System.Exception ex)
        {
            VA.WriteToLog("[EGO] Interpret error: " + ex.Message, "red");
        }
    }
}</Context>
